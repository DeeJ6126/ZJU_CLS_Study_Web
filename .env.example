# Comma-separated CC98 names that receive the administrator role on registration.
ADMIN_CC98_NAMES=cc98_bio_visitor

# Optional persistent paths for the Node service.
AUTH_DB_FILE=server/data/auth.sqlite
CONTENT_DB_FILE=server/data/content.sqlite
CONTENT_UPLOAD_DIR=server/data/content-uploads
PROFILE_AVATAR_DIR=server/data/profile-avatars

# ZJU mailbox SMTP. Keep the client-specific password outside the repository.
SMTP_HOST=smtp.zju.edu.cn
SMTP_PORT=994
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=生科智学
