# Primary administrator provisioning: numeric student IDs, comma-separated.
# The matching @zju.edu.cn mailbox must still pass email-code verification.
ADMIN_STUDENT_IDS=

# Legacy CC98 administrator provisioning. The endpoints remain available for
# compatibility but are intentionally hidden from the frontend.
ADMIN_CC98_NAMES=cc98_bio_visitor
# High-entropy shared secret required in addition to the allowlist during controlled administrator registration.
ADMIN_INVITE_TOKEN=

# Optional persistent paths for the Node service.
AUTH_DB_FILE=server/data/auth.sqlite
QUIZ_DB_FILE=server/data/auth.sqlite
CONTENT_DB_FILE=server/data/content.sqlite
STUDENT_HOMEPAGE_DB_FILE=server/data/student-homepages.sqlite
CONTENT_UPLOAD_DIR=server/data/content-uploads
PROFILE_AVATAR_DIR=server/data/profile-avatars

# ZJU mailbox SMTP. Keep the client-specific password outside the repository.
SMTP_HOST=smtp.zju.edu.cn
SMTP_PORT=994
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=生科智学
